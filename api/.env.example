# Copy to .env
PORT=3000
# PostgreSQL connection string (use your Vercel Prisma Postgres URL in production).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_bright?schema=public"
SUPPLIER_SLA_MINUTES=20
FEATURE_QUICK_CHECKOUT=false
FEATURE_RECURRING_ORDERS=true
FEATURE_OUTBOUND_PILOT=false
# Optional: provision the first admin during startup. Use a unique phone and
# a secret password of at least 12 characters; keep both out of source control.
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=
