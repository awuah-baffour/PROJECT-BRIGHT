# Copy to .env
PORT=3000
# Local database file (zero setup). Production Postgres: switch the
# datasource provider in prisma/schema.prisma to "postgresql" and set this
# to the Postgres connection string, then run `npx prisma migrate dev`.
DATABASE_URL="file:./dev.db"
SUPPLIER_SLA_MINUTES=20
FEATURE_QUICK_CHECKOUT=false
FEATURE_RECURRING_ORDERS=true
FEATURE_OUTBOUND_PILOT=false
