{
  "name": "project-bright-api",
  "version": "0.1.0",
  "private": true,
  "description": "Project Bright Phase 0 - modular monolith API (Node + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "vercel-build": "prisma generate && prisma migrate deploy && npm run build",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/scripts/smoke.ts",
    "verify": "tsx src/scripts/verify.ts",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "prisma": "^5.20.0",
    "tsx": "^4.16.2",
    "typescript": "^5.6.2"
  },
  "allowScripts": {}
}
