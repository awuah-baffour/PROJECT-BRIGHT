// PostgreSQL is the source of truth for local and deployed environments.
// AD-15 append-only events + audit.
// Table strategy:
// - Retailer, Supplier, User, and Session back live account onboarding.
// - Pilot order tables (OrderDoc..Tracking) back the API today; payment-ledger
//   models remain planned.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Retailer {
  id        String     @id @default(cuid())
  phone     String     @unique
  shopName  String
  createdAt DateTime   @default(now())
  staff     Staff[]
  locations Location[]
  orders    Order[]
  users     User[]
}

model Staff {
  id         String   @id @default(cuid())
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id])
  phone      String
  role       String   // owner | manager | staff
  dailyCap   Int?
  perOrderCap Int?
}

model Location {
  id            String   @id @default(cuid())
  retailerId    String
  retailer      Retailer @relation(fields: [retailerId], references: [id])
  gpsLat        Float?
  gpsLng        Float?
  address       String
  landmark      String
  deliveryNotes String?
  orders        Order[]
}

model Supplier {
  id               String      @id @default(cuid())
  name             String
  approved         Boolean     @default(false)
  onboardingStatus String      @default("pending")
  rating           Float       @default(0)
  slices           OrderSlice[]
  users            User[]
}

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  passwordHash  String
  role          String
  phoneVerified Boolean   @default(false)
  active        Boolean   @default(true)
  dailyCap      Int?
  perOrderCap   Int?
  retailerId    String?
  retailer      Retailer? @relation(fields: [retailerId], references: [id])
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  createdAt     DateTime  @default(now())
  sessions      Session[]

  @@index([role])
  @@index([retailerId])
  @@index([supplierId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id         String  @id @default(cuid())
  supplierId String?
  name       String
  variant    String?
  unit       String
  price      Int     // minor units (pesewas)
  inStock    Int     @default(0)
}

model Order {
  id                 String       @id @default(cuid())
  retailerId         String
  retailer           Retailer     @relation(fields: [retailerId], references: [id])
  deliveryLocationId String
  location           Location     @relation(fields: [deliveryLocationId], references: [id])
  status             String       @default("draft")
  total              Int          @default(0)
  slices             OrderSlice[]
  payments           Payment[]
}

model OrderSlice {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id])
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  status     String    @default("assigned")
  respondBy  DateTime?
  items      SliceItem[]
}

model SliceItem {
  id      String     @id @default(cuid())
  sliceId String
  slice   OrderSlice @relation(fields: [sliceId], references: [id])
  name    String
  qty     Int
  price   Int
}

model Payment {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  provider      String
  reference     String         @unique
  amount        Int
  status        String         @default("pending")
  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])
  party     String  // supplier:<id> | transport:<id> | platform
  amount    Int
}

model Event {
  id        String   @id @default(cuid())
  orderId   String?
  type      String
  payload   String   // JSON-encoded text
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---- Pilot tables (live today) ----

model OrderDoc {
  id        String   @id
  status    String
  total     Int      @default(0)
  data      String   // JSON-encoded: deliveryLocationId(s), window, quote, slices, createdAt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Issue {
  id         String   @id
  orderId    String
  type       String
  detail     String?
  status     String   @default("open")
  resolution String?
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model Purchase {
  id          String   @id
  locationId  String
  productName String
  qty         Int
  createdAt   DateTime @default(now())

  @@index([locationId])
}

model Preference {
  id                  String  @id
  locationId          String
  productName         String
  preferredSupplierId String?
  autoApprove         Boolean @default(false)

  @@unique([locationId, productName])
}

model Recurring {
  id                 String   @id
  sourceOrderId      String
  items              String   // JSON-encoded [{name, qty}]
  deliveryLocationId String
  frequency          String
  nextRun            DateTime
  paused             Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model Outbound {
  id             String    @id
  sourceChannel  String
  serviceType    String
  pickupNote     String
  customerName   String
  customerPhone  String
  dropoffAddress String
  landmark       String
  packageNote    String    @default("")
  codAmount      Int       @default(0)
  status         String    @default("created")
  rider          String?
  proofRecipient String?
  proofAt        DateTime?
  createdAt      DateTime  @default(now())
}

model Tracking {
  orderId String @id
  pings   String   // JSON-encoded Ping[]
}
